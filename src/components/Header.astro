---
import { getCollection } from 'astro:content';
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';

// 1. Obtener todos los posts que no sean borradores
const allPosts = await getCollection('blog');
const publishedPosts = allPosts.filter((post) => !post.data.draft);

// 2. Extraer tags únicos y ordenarlos por frecuencia de uso
const tagCounts = publishedPosts
	.flatMap((post) => post.data.tags || [])
	.reduce((acc, tag) => {
		acc[tag] = (acc[tag] || 0) + 1;
		return acc;
	}, {} as Record<string, number>);

// Obtener los 5 tags más populares
const popularTags = Object.entries(tagCounts)
	.sort((a, b) => b[1] - a[1])
	.slice(0, 5)
	.map(([tag]) => tag);
---

<!-- TOPBAR MÓVIL -->
<div class="mobile-topbar">
	<a href="/" class="brand-title">{SITE_TITLE}</a>
	<button id="menu-toggle" class="hamburger-btn" aria-label="Abrir menú" aria-expanded="false">
		<svg id="icon-menu" viewBox="0 0 24 24" width="24" height="24" stroke="currentColor" stroke-width="2" fill="none">
			<line x1="3" y1="12" x2="21" y2="12"></line>
			<line x1="3" y1="6" x2="21" y2="6"></line>
			<line x1="3" y1="18" x2="21" y2="18"></line>
		</svg>
		<svg id="icon-close" viewBox="0 0 24 24" width="24" height="24" stroke="currentColor" stroke-width="2" fill="none" class="is-hidden">
			<line x1="18" y1="6" x2="6" y2="18"></line>
			<line x1="6" y1="6" x2="18" y2="18"></line>
		</svg>
	</button>
</div>

<div id="sidebar-backdrop" class="sidebar-backdrop"></div>

<!-- SIDEBAR -->
<aside id="sidebar" class="sidebar" aria-label="Navegación principal">
	<div class="sidebar-header">
		<a href="/" class="brand-title">{SITE_TITLE}</a>
		<span class="brand-subtitle">Data & Software Engineering</span>
	</div>

	<nav class="nav-menu">
		<span class="nav-label">Navegación</span>
		
		<HeaderLink href="/">
			<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg>
			Home
		</HeaderLink>

		<!-- DROPDOWN DINÁMICO DE BLOG -->
		<details class="nav-dropdown" open>
			<summary class="dropdown-trigger">
				<span class="trigger-content">
					<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path></svg>
					Blog
				</span>
				<svg class="chevron" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"></polyline></svg>
			</summary>
			<div class="dropdown-items">
				<a href="/blog">Todos los artículos</a>
				{popularTags.map((tag) => (
					<a href={`/blog/tags/${encodeURIComponent(tag.toLowerCase())}`}>
						# {tag} <span class="tag-count">({tagCounts[tag]})</span>
					</a>
				))}
			</div>
		</details>

		<HeaderLink href="/projects">
			<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path></svg>
			Proyectos
		</HeaderLink>

		<HeaderLink href="/newsletter">
			<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
			Newsletter
		</HeaderLink>

		<HeaderLink href="/about">
			<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
			Sobre mí
		</HeaderLink>
	</nav>

	<div class="sidebar-footer">
		<span class="nav-label">Redes</span>
		<div class="social-links">
			<a href="https://github.com/a-ceron" target="_blank" rel="noreferrer" aria-label="GitHub">
				<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path></svg>
			</a>
		</div>
	</div>
</aside>

<script>
	const menuToggle = document.getElementById('menu-toggle');
	const sidebar = document.getElementById('sidebar');
	const backdrop = document.getElementById('sidebar-backdrop');
	const iconMenu = document.getElementById('icon-menu');
	const iconClose = document.getElementById('icon-close');

	function toggleMenu() {
		const isOpen = sidebar?.classList.toggle('is-active');
		backdrop?.classList.toggle('is-active', isOpen);
		menuToggle?.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
		menuToggle?.setAttribute('aria-label', isOpen ? 'Cerrar menú' : 'Abrir menú');
		iconMenu?.classList.toggle('is-hidden', isOpen);
		iconClose?.classList.toggle('is-hidden', !isOpen);
	}

	menuToggle?.addEventListener('click', toggleMenu);
	backdrop?.addEventListener('click', toggleMenu);
	sidebar?.querySelectorAll('a').forEach((link) => {
		link.addEventListener('click', () => {
			if (sidebar?.classList.contains('is-active')) toggleMenu();
		});
	});

	document.addEventListener('keydown', (event) => {
		if (event.key === 'Escape' && sidebar?.classList.contains('is-active')) toggleMenu();
	});
</script>

<style>
	:root {
		--sidebar-w: 260px;
		--bg-sidebar: #050506;
		--text-sidebar: #a1a1aa;
		--border-sidebar: #27272a;
		--accent-color: #f4f4f5;
	}

	.mobile-topbar {
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding: 0.85rem 1.25rem;
		background: var(--bg-sidebar);
		color: #ffffff;
		position: sticky;
		top: 0;
		z-index: 100;
		border-bottom: 1px solid var(--border-sidebar);
	}

	.hamburger-btn {
		background: transparent;
		border: none;
		color: #ffffff;
		cursor: pointer;
		display: flex;
		align-items: center;
	}

	.is-hidden { display: none !important; }

	.sidebar-backdrop {
		position: fixed;
		inset: 0;
		background: rgba(0, 0, 0, 0.6);
		backdrop-filter: blur(4px);
		z-index: 150;
		opacity: 0;
		pointer-events: none;
		transition: opacity 0.3s ease;
	}

	.sidebar-backdrop.is-active {
		opacity: 1;
		pointer-events: auto;
	}

	.sidebar {
		position: fixed;
		top: 0;
		left: 0;
		bottom: 0;
		width: var(--sidebar-w);
		background: var(--bg-sidebar);
		border-right: 1px solid var(--border-sidebar);
		display: flex;
		flex-direction: column;
		padding: 2rem 1.25rem;
		z-index: 200;
		transform: translateX(-100%);
		transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
		overflow-y: auto;
	}

	.sidebar.is-active { transform: translateX(0); }

	.brand-title {
		font-size: 1.15rem;
		font-weight: 700;
		color: #ffffff;
		text-decoration: none;
	}

	.brand-subtitle {
		display: block;
		font-size: 0.75rem;
		color: var(--text-sidebar);
		margin-top: 0.2rem;
	}

	.nav-menu {
		margin-top: 2rem;
		flex-grow: 1;
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
	}

	.nav-label {
		font-size: 0.7rem;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--text-sidebar);
		margin-bottom: 0.5rem;
		font-weight: 600;
	}

	:global(.sidebar nav a) {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		padding: 0.65rem 0.85rem;
		color: var(--text-sidebar);
		text-decoration: none;
		border-radius: 8px;
		font-size: 0.925rem;
		transition: all 0.2s ease;
	}

	:global(.sidebar nav a:hover) {
		background: #1c1c1f;
		color: #ffffff;
	}
	:global(.sidebar nav a.active) {
		background: #1c1c1f;
		color: #fff;
		border-left: 3px solid var(--accent-color);
	}

	/* DROPDOWN STYLES */
	.nav-dropdown {
		border-radius: 8px;
	}

	.dropdown-trigger {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 0.65rem 0.85rem;
		color: var(--text-sidebar);
		cursor: pointer;
		font-size: 0.925rem;
		border-radius: 8px;
		user-select: none;
		list-style: none;
		transition: background 0.2s ease;
	}

	.dropdown-trigger::-webkit-details-marker { display: none; }

	.dropdown-trigger:hover {
		background: #1c1c1f;
		color: #ffffff;
	}

	.trigger-content {
		display: flex;
		align-items: center;
		gap: 0.75rem;
	}

	.chevron { transition: transform 0.2s ease; }

	.nav-dropdown[open] .chevron { transform: rotate(180deg); }

	.dropdown-items {
		display: flex;
		flex-direction: column;
		gap: 0.2rem;
		padding-left: 1.75rem;
		margin-top: 0.25rem;
	}

	.dropdown-items a {
		font-size: 0.85rem;
		padding: 0.45rem 0.75rem;
		justify-content: space-between;
	}

	.tag-count {
		font-size: 0.75rem;
		color: var(--text-sidebar);
	}

	.sidebar-footer {
		padding-top: 1.5rem;
		border-top: 1px solid var(--border-sidebar);
		margin-top: 1rem;
	}

	.social-links {
		display: flex;
		gap: 1rem;
		margin-top: 0.5rem;
	}

	.social-links a { color: var(--text-sidebar); }
	.social-links a:hover { color: #ffffff; }

	@media (min-width: 1024px) {
		.mobile-topbar, .sidebar-backdrop { display: none !important; }

		.sidebar {
			position: fixed;
			left: 0;
			top: 0;
			height: 100vh;
			box-sizing: border-box;
			transform: translateX(0);
		}
	}
</style>